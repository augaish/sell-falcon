# متغيرات خدمة سيل فالكون. هذا الملف قالب بأسماء فقط: لا تضع فيه قيمًا سرية ولا ترفعه بقيم.
# القيم تُدخل في لوحة الاستضافة (Variables)، والسرّي منها يدخله المالك بنفسه.

# --- إعدادات الخدمة (غير سرّية) ---
SELLFALCON_DATA=/data
SELLFALCON_SECURE=1
# فارغ للنطاق الفرعي sellfalcon.oshhh.fun
SELLFALCON_BASE_PATH=

# --- حساب المالك: يُنشأ عند أول تشغيل فقط ---
SELLFALCON_OWNER_EMAIL=
# سرّي. 12 حرفًا على الأقل. يُغيَّر من التطبيق بعد أول دخول ثم يُحذف هذا المتغير.
SELLFALCON_OWNER_PASSWORD=

# --- Claude: تُترك فارغة عند النشر الأول. التشغيل المدفوع مطفأ افتراضيًا ---
SELLFALCON_EXPECT_ORG=
# سرّي. مفتاح محصور بمساحة العمل sf-synthetic.
SELLFALCON_ANTHROPIC_KEY_SYNTHETIC=
SELLFALCON_EXPECT_WORKSPACE_SYNTHETIC=
